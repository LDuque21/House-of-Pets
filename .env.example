# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon connection string (Dashboard -> Connection Details -> "Pooled connection")
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Google AI Studio API key (aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Optional: give individual agents their own key (their own Google Cloud/AI
# Studio project) so they don't share one project's daily quota. A key only
# helps if it's from a genuinely different project -- multiple keys from the
# same project still share one pool. Falls back to GEMINI_API_KEY if unset.
# GEMINI_API_KEY_DIET=""
# GEMINI_API_KEY_HYGIENE=""
# GEMINI_API_KEY_HEALTH=""
# GEMINI_API_KEY_INSURANCE=""
# GEMINI_API_KEY_MATERIALS=""
